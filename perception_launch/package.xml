<?xml version="1.0"?>
<package format="3">
  <name>perception_launch</name>
  <version>0.1.0</version>
  <description>
    SCV perception bring-up: starts the SCV_Perception nodes the navigation stack needs.
  </description>
  <maintainer email="nev@example.com">nev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>traversability_grid</exec_depend>
  <exec_depend>ground_filter</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
