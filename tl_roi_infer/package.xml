<?xml version="1.0"?>
<package format="3">
  <name>tl_roi_infer</name>
  <version>0.1.0</version>
  <description>Traffic light ROI inference (YOLO) for ROS2</description>
  <maintainer email="jjs523@todo.todo">jjs523</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>vision_msgs</exec_depend>

  <!-- 파이썬 사이드(ultralytics/torch/opencv-python 등)는 pip로 설치되어 있어야 함 -->
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
